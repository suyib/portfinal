# Supabase → Project Settings → API (use a NEW project, not the old portfolio's)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). A legacy anon key also works, set as
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead. Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the site, used for the sitemap and social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
